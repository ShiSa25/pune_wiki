---
import Base from "../layouts/Base.astro";
import { cardLine, places, placesIn, sections } from "../lib/guide";
---

<Base
  title="pune"
  description="A local list of Pune places: old rooms, misal, coffee, a few bars, and things to do. One page, with a map of the pins that were checked."
>
  <a class="skip" href="#content">Skip to content</a>
  <header class="top">
    <div class="brand">
      <span class="mark" aria-hidden="true">pu</span>
      <div class="brand-text">
        <h1>pune</h1>
        <p>a local list for eating, drinking, and a day out.</p>
      </div>
    </div>
    <form class="search" id="filters" role="search">
      <label>
        <span class="sr">Search</span>
        <input id="q" type="search" name="q" autocomplete="off" placeholder="Search" />
      </label>
    </form>
  </header>
  <div class="nav-bar">
    <div class="switch" role="group" aria-label="List or map">
      <button type="button" data-view="list" aria-pressed="true">List</button>
      <button type="button" data-view="map" aria-pressed="false">Map</button>
    </div>
    <div class="pills" role="group" aria-label="Sections">
      <button type="button" class="pill" data-section="" aria-pressed="true">All ({places.length})</button>
      {
        sections.map((section) => (
          <button type="button" class="pill" data-section={section.id} aria-pressed="false">
            <span class="dot" style={`background:${section.color}`} />
            {section.label} ({placesIn(section.id).length})
          </button>
        ))
      }
    </div>
    <p id="count" class="count" aria-live="polite" hidden></p>
  </div>
  <div class="app" data-app>
    <div class="list-pane">
      <div id="empty" class="empty" hidden>
        <h2>No places match</h2>
        <p>Nothing in this list matches that search. Clear it to see every place.</p>
        <button type="button" id="reset">Reset</button>
      </div>
      <noscript>
        <p class="map-banner">Filters and the map need JavaScript. The full list is on this page.</p>
      </noscript>
      <main id="content">
        {
          sections.map((section) => (
            <section class="group" data-group={section.id} data-color={section.color} id={section.id}>
              <header class="group-head">
                <h2>{section.label}</h2>
                <p>{section.dek}</p>
              </header>
              <div class="cards">
                {placesIn(section.id).map((place) => (
                  <article class="card" data-place={place.id} id={place.id}>
                    <button type="button" class="card-hit">
                      <span class="card-name">{place.name}</span>
                      <span class="card-meta">
                        <span class="dot" style={`background:${section.color}`} />
                        {place.kind} · {place.area}
                      </span>
                      <span class="card-line">{cardLine(place.line)}</span>
                    </button>
                    <p class="card-actions">
                      {place.mapsUrl && <a href={place.mapsUrl} rel="noreferrer">Google Maps</a>}
                      {!place.pin && <span>No verified pin</span>}
                    </p>
                    <details class="notes">
                      <summary>Notes</summary>
                      {cardLine(place.line) !== place.line && <p>{place.line}</p>}
                      {place.dish && <p>{place.dish}</p>}
                      {place.flag && <p>{place.flag}</p>}
                      {place.pinNote && <p>{place.pinNote}</p>}
                      {place.address && <p>{place.address}</p>}
                      {place.coordTitle && <p>{place.coordTitle}. Checked {place.coordCheckedOn}.</p>}
                      <ul>
                        {place.sources.map((source) => (
                          <li>
                            <a href={source.url} rel="noreferrer">{source.title}</a>
                            <span> · {source.type} · {source.checkedOn}</span>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </main>
      <footer class="colophon">
        <p>Source notes were checked on 7 November 2026. Hours and a live “open” line are not copied here.</p>
        <p>Google’s star ratings are not reprinted. Open the listing if you want the current number.</p>
        <p>This page asks search engines not to index it. Who can open the link is decided by the host, not by this page.</p>
      </footer>
    </div>
    <aside class="map-pane">
      <p id="map-note" class="map-banner" hidden>No verified pins match this filter.</p>
      <p id="tile-note" class="map-banner" hidden>Map tiles did not load. The list still works. Tiles come from OpenFreeMap.</p>
      <div id="map" role="region" aria-label="Map of places with a verified pin"></div>
    </aside>
  </div>
  <script>
    import "../scripts/app.ts";
  </script>
</Base>
