---
import Base from "../layouts/Base.astro";
import { places, placesIn, sections } from "../lib/guide";
import { EXTERNAL_ICON_PATH } from "../lib/outward";
---

<Base
  title="pune"
  description="A local’s guide to falling in love with Pune"
>
  <a class="skip" href="#content">Skip to content</a>
  <header class="top">
    <div class="brand">
      <img class="mark" src="/favicon.svg" alt="" width="36" height="36" />
      <div class="brand-text">
        <h1>pune</h1>
        <p>A local’s guide to falling in love with Pune</p>
      </div>
    </div>
  </header>
  <div class="nav-bar">
    <div class="pills" role="group" aria-label="Sections">
      <button type="button" class="pill" data-section="" aria-pressed="true">All ({places.length})</button>
      {
        sections.map((section) => (
          <button type="button" class="pill" data-section={section.id} aria-pressed="false">
            <span class="dot" style={`background:${section.color}`} />
            {section.label} ({placesIn(section.id).length})
          </button>
        ))
      }
    </div>
    <p id="count" class="count" aria-live="polite" hidden></p>
  </div>
  <div class="app" data-app>
    <div class="list-pane">
      <noscript>
        <p class="map-banner">The map needs JavaScript. The full list is on this page.</p>
      </noscript>
      <main id="content">
        {
          sections.map((section) => (
            <section class="group" data-group={section.id} data-color={section.color} id={section.id}>
              <header class="group-head">
                <h2>{section.label}</h2>
                <p>{section.dek}</p>
              </header>
              <div class="cards">
                {placesIn(section.id).map((place) => (
                  <article class="card" data-place={place.id} id={place.id}>
                    <button type="button" class="card-hit">
                      <span class="card-name">{place.name}</span>
                      <span class="card-meta">
                        <span class="dot" style={`background:${section.color}`} />
                        {place.kind} · {place.area}
                      </span>
                      <span class="card-line">{place.summary}</span>
                    </button>
                    {
                      place.mapsUrl ? (
                        <p class="card-actions">
                          <a href={place.mapsUrl} target="_blank" rel="noopener noreferrer">
                            Google Maps
                            <svg class="ext" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                              <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d={EXTERNAL_ICON_PATH} />
                            </svg>
                          </a>
                        </p>
                      ) : null
                    }
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </main>
    </div>
    <aside class="map-pane">
      <p id="map-note" class="map-banner" hidden>No verified pins match this filter.</p>
      <p id="tile-note" class="map-banner" hidden>Map tiles did not load. The list still works. Tiles come from OpenFreeMap.</p>
      <div id="map" role="region" aria-label="Map of places with a verified pin"></div>
    </aside>
  </div>
    <button type="button" class="view-fab" id="view-toggle" aria-pressed="false">
      <span id="view-toggle-label">Show map</span>
      <svg class="fab-map" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z" />
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 5.764v15M9 3.236v15" />
      </svg>
      <svg class="fab-list" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
        <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 5h.01M3 12h.01M3 19h.01M8 5h13M8 12h13M8 19h13" />
      </svg>
    </button>
    <footer class="colophon">
    <p>Made with love by Shivanshu Sahu</p>
  </footer>
  <script>
    import "../scripts/app.ts";
  </script>
</Base>
