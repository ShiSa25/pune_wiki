---
import Base from "../layouts/Base.astro";
import { places, placesIn, sections } from "../lib/guide";
import { EXTERNAL_ICON_PATH, onwardLink } from "../lib/outward";
---

<Base
  title="pune"
  description="A local’s guide to falling in love with Pune."
>
  <a class="skip" href="#content">Skip to content</a>
  <header class="top">
    <div class="brand">
      <img class="mark" src="/favicon.svg" alt="" width="40" height="40" />
      <div class="brand-text">
        <h1>pune</h1>
        <p>A local’s guide to falling in love with Pune.</p>
      </div>
    </div>
    <form class="search" id="filters" role="search">
      <label>
        <span class="sr">Search</span>
        <input id="q" type="search" name="q" autocomplete="off" placeholder="Search" />
      </label>
    </form>
  </header>
  <div class="nav-bar">
    <div class="switch" role="group" aria-label="List or map">
      <button type="button" data-view="list" aria-pressed="true">List</button>
      <button type="button" data-view="map" aria-pressed="false">Map</button>
    </div>
    <div class="pills" role="group" aria-label="Sections">
      <button type="button" class="pill" data-section="" aria-pressed="true">All ({places.length})</button>
      {
        sections.map((section) => (
          <button type="button" class="pill" data-section={section.id} aria-pressed="false">
            <span class="dot" style={`background:${section.color}`} />
            {section.label} ({placesIn(section.id).length})
          </button>
        ))
      }
    </div>
    <p id="count" class="count" aria-live="polite" hidden></p>
  </div>
  <div class="app" data-app>
    <div class="list-pane">
      <div id="empty" class="empty" hidden>
        <h2>No places match</h2>
        <p>Nothing in this list matches that search. Clear it to see every place.</p>
        <button type="button" id="reset">Reset</button>
      </div>
      <noscript>
        <p class="map-banner">Filters and the map need JavaScript. The full list is on this page.</p>
      </noscript>
      <main id="content">
        {
          sections.map((section) => (
            <section class="group" data-group={section.id} data-color={section.color} id={section.id}>
              <header class="group-head">
                <h2>{section.label}</h2>
                <p>{section.dek}</p>
              </header>
              <div class="cards">
                {placesIn(section.id).map((place) => (
                  <article class="card" data-place={place.id} id={place.id}>
                    <button type="button" class="card-hit">
                      <span class="card-name">{place.name}</span>
                      <span class="card-meta">
                        <span class="dot" style={`background:${section.color}`} />
                        {place.kind} · {place.area}
                      </span>
                      <span class="card-line">{place.summary}</span>
                    </button>
                    <p class="card-actions">
                      <a href={onwardLink(place).href} rel="noreferrer">
                        {onwardLink(place).label}
                        <svg class="ext" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
                          <path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d={EXTERNAL_ICON_PATH} />
                        </svg>
                      </a>
                    </p>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </main>
      <footer class="colophon">
        <p>Made with love by Shivanshu Sahu</p>
      </footer>
    </div>
    <aside class="map-pane">
      <p id="map-note" class="map-banner" hidden>No verified pins match this filter.</p>
      <p id="tile-note" class="map-banner" hidden>Map tiles did not load. The list still works. Tiles come from OpenFreeMap.</p>
      <div id="map" role="region" aria-label="Map of places with a verified pin"></div>
    </aside>
  </div>
  <script>
    import "../scripts/app.ts";
  </script>
</Base>
