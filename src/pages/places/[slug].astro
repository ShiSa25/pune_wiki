---
import Base from "../../layouts/Base.astro";
import { findPlace, places } from "../../lib/catalog";
import { categoryLabel } from "../../lib/categories";
import { formatDay } from "../../lib/format";
import { mapsSearchUrl } from "../../lib/maps";

export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug } }));
}

const { slug } = Astro.params;
const place = findPlace(slug ?? "");
if (!place) throw new Error(`Missing place ${slug}`);
---

<Base title={place.name} description={place.summary}>
  <article class="prose" id="content">
    <p class="meta">{categoryLabel(place.category)} · {place.area}</p>
    <h1>{place.name}</h1>
    {place.nameMarathi && <p class="mr">{place.nameMarathi}</p>}
    <p class="badge">Source-checked {formatDay(place.updatedOn)} · not personally visited</p>
    <p class="lede">{place.summary}</p>
    <p>{place.note}</p>
    <p>
      <a href={mapsSearchUrl(place.mapsQuery)}>Open {place.name} in Google Maps</a>
    </p>
    <h2>Recorded</h2>
    <ul class="fact-list">
      {place.known.map((item) => <li>{item}</li>)}
    </ul>
    {
      place.venueReported.length > 0 && (
        <>
          <h2>Stated by the venue</h2>
          <ul class="fact-list">
            {place.venueReported.map((item) => (
              <li>
                <strong>{item.label}.</strong> {item.value} Checked {formatDay(item.checkedOn)}. This can change;
                reconfirm.
              </li>
            ))}
          </ul>
        </>
      )
    }
    <h2>Left out on purpose</h2>
    <ul class="fact-list">
      {place.omitted.map((item) => <li>{item}</li>)}
    </ul>
    <h2>Sources</h2>
    <ul class="fact-list sources">
      {
        place.sources.map((source) => (
          <li>
            <a href={source.url}>{source.title}</a>
            <span class="meta"> · checked {formatDay(source.checkedOn)} · {source.usedFor}</span>
          </li>
        ))
      }
    </ul>
    {
      place.recheck.length > 0 && (
        <>
          <h2>Check again before you go</h2>
          <p>These links are indexes, not proof that a route is open.</p>
          <ul class="fact-list sources">
            {place.recheck.map((source) => (
              <li>
                <a href={source.url}>{source.title}</a>
                <span class="meta"> · {source.usedFor}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }
    <p>
      <a href={`/corrections/${place.slug}`}>Suggest a correction for {place.name}</a>
    </p>
  </article>
</Base>
