---
import Base from "../../layouts/Base.astro";
import { findPlace, places } from "../../lib/catalog";

export function getStaticPaths() {
  return [
    ...places.map((place) => ({ params: { slug: place.slug } })),
    { params: { slug: "general" } },
  ];
}

const slug = Astro.params.slug ?? "general";
const place = slug === "general" ? undefined : findPlace(slug);
if (slug !== "general" && !place) throw new Error(`Missing correction target ${slug}`);

const subject = place ? `${place.name} (${place.slug})` : "General note";
const page = place ? `/places/${place.slug}` : "/";
const prefill = `Place: ${subject}
Page: ${page}
What is wrong:

What I checked, and when:

Source:
`;
---

<Base title={`Correction · ${place?.name ?? "General"}`} description="Copy a correction note. This page does not send it.">
  <article class="prose" id="content">
    <h1>Correction{place ? ` · ${place.name}` : ""}</h1>
    <p>
      Edit the note if you want, then copy it. Nothing is sent or saved. There is no confirmation because there is no submission.
    </p>
    <label class="field" for="note">Note to copy</label>
    <textarea id="note">{prefill}</textarea>
    <p>
      <button class="button" type="button" id="copy-note">Copy note</button>
    </p>
    <p id="copy-status" role="status">Nothing is sent or saved by this site.</p>
    <p><a href="/corrections">All places</a></p>
  </article>
  <script>
    import "../../scripts/browse.ts";
  </script>
</Base>
