---
import PlaceList from "../../components/PlaceList.astro";
import Base from "../../layouts/Base.astro";
import { areaOptions, placesInArea } from "../../lib/catalog";

export function getStaticPaths() {
  return areaOptions().map((area) => ({
    params: { area: area.slug },
    props: { label: area.label },
  }));
}

interface Props {
  label: string;
}

const { area = "" } = Astro.params;
const { label } = Astro.props;
const matched = placesInArea(area);
---

<Base title={label} description={`Places in ${label} from this short Pune list.`}>
  <main id="content" class="prose">
    <h1>{label}</h1>
    <p class="dek">Neighbourhood page. It does not measure distance from anywhere else.</p>
    <p class="count">{matched.length} {matched.length === 1 ? "place" : "places"}</p>
    <PlaceList places={matched} />
    <p><a href="/">Back to the full list</a></p>
  </main>
</Base>
