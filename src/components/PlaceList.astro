---
import { categoryLabel } from "../lib/categories";
import { mapsSearchUrl } from "../lib/maps";
import type { Place } from "../lib/schema";

interface Props {
  places: Place[];
  grouped?: boolean;
}

const { places, grouped = false } = Astro.props;
---

{
  places.map((place) => (
    <article class="row" data-place={place.slug} data-category={place.category} data-area={place.areaSlug}>
      <div class="row-top">
        <h3>
          <a href={`/places/${place.slug}`}>{place.name}</a>
        </h3>
        <a class="map-link" href={mapsSearchUrl(place.mapsQuery)} rel="noreferrer">
          Map
          <span class="sr"> for {place.name}</span>
        </a>
      </div>
      {place.nameMarathi && <p class="mr">{place.nameMarathi}</p>}
      <p class="meta">
        {place.area}
        {grouped ? "" : ` · ${categoryLabel(place.category)}`}
        {" · "}
        Source-checked
      </p>
      <p class="summary">{place.summary}</p>
    </article>
  ))
}
